# Environment 
#############################################################################################

# -------------------- Airflow int ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/airflow
	VEH_XYZ 0.000 0.940 -6.214
	EVENT_START_COND sim/flightmodel/position/true_airspeed > 2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Airflow ext ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/airflow_ext
	VEH_XYZ 0.000 0.000 -0.522
	EVENT_START_COND sim/flightmodel/position/true_airspeed > 2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Rain int ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/rain_int
	VEH_XYZ 0.000 0.000 -0.522
	EVENT_START_COND sim/weather/precipitation_on_aircraft_ratio != 0
	EVENT_END_COND sim/weather/precipitation_on_aircraft_ratio == 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/crash
	VEH_XYZ 0.000 0.000 -0.522
	EVENT_START_COND sim/flightmodel/failures/onground_any == 1
	EVENT_START_COND sim/flightmodel/ground/surface_texture_type == 1
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/crash
	VEH_XYZ 0.000 0.000 -0.522
	EVENT_START_COND sim/flightmodel/failures/onground_any == 1
	EVENT_START_COND sim/flightmodel/ground/surface_texture_type == 7
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/crash
	VEH_XYZ 0.000 0.000 -0.522
	EVENT_START_COND sim/flightmodel2/misc/has_crashed == 1
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/water_land
	VEH_XYZ 0.000 0.000 -0.522
	EVENT_START_COND sim/flightmodel/failures/onground_any == 1
	EVENT_START_COND sim/flightmodel/ground/surface_texture_type == 1
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/water_land
	VEH_XYZ 0.000 0.000 -0.522
	EVENT_START_COND sim/flightmodel/failures/onground_any == 1
	EVENT_START_COND sim/flightmodel/ground/surface_texture_type == 7
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/belly_land
	VEH_XYZ 0.000 0.000 -0.522
	EVENT_START_COND sim/aircraft/parts/acf_gear_deploy[0] < 0.2
	EVENT_START_COND sim/aircraft/parts/acf_gear_deploy[1] < 0.2
	EVENT_START_COND sim/flightmodel/failures/onground_any == 1
	EVENT_START_COND sim/flightmodel/ground/surface_texture_type != 1
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Tire roll 1 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/ground_roll
	VEH_PART tire 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/gear/tire_rotation_speed_rad_sec[0] > 0.2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/tire_impact
	VEH_PART tire 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/gear/total_deflection_rate[0] > 1
	EVENT_START_COND sim/flightmodel2/gear/tire_vertical_deflection_mtr[0] > 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/tire_bump
	VEH_PART tire 0
	PARAM_DREF_IDX 0
	EVENT_START_COND ABS_DELTA=sim/flightmodel2/gear/tire_vertical_deflection_mtr[0] > 0.5
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/environment/wheel_skid
	VEH_PART tire 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/gear/on_ground[0] == 1
	EVENT_START_COND sim/flightmodel2/gear/tire_skid_ratio[0] > 0
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

