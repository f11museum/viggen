1000
ACF_SOUNDS

########################################################
# F-4 Phantom II sound bank                            #
# 1.0.0-rc-1                                           #
# Daniela Rodriguez Careri <daniela@x-plane.com>       #
# Laminar Research                                     #
########################################################

DISABLE_LEGACY_ALERT_SOUNDS

# Spaces 
#############################################################################################

# -------------------- Cockpit ---------------------
BEGIN_SOUND_SPACE
	SOUND_INDEX 0
	BLEND_DEPTH 0.1
	AABB -0.600 0.100 -7.122 0.600 1.560 -3.392
END_SOUND_SPACE

# Snapshots 
#############################################################################################

# -------------------- Cockpit ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /in_cockpit
	VEH_XYZ 0.000 0.940 -6.214
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/operation/sound/inside_ratio[0] != 0
	EVENT_END_COND sim/operation/sound/inside_ratio[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Door ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /in_cockpit_canopy_open
	VEH_XYZ 0.394 0.866 -5.713
	PARAM_DREF_IDX 23
	EVENT_START_COND sim/flightmodel2/misc/custom_slider_ratio[23] > 0
	EVENT_END_COND sim/flightmodel2/misc/custom_slider_ratio[23] == 0
END_SOUND_ATTACHMENT

# Engines 
#############################################################################################

# -------------------- Engine 1 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/engines/engine_1
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/N2_percent[0] > 0
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Afterburner 1 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/engines/afterburner_1
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/afterburner_ratio[0] > 0
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Starter ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/engines/starter
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/starter_is_running[0] != 0
	EVENT_END_COND sim/flightmodel2/engines/starter_is_running[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Engine fire ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/engines/engine_fire
	VEH_PART engine 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/operation/failures/rel_engfir0 == 6
	EVENT_END_COND sim/operation/failures/rel_engfir0 != 6
END_SOUND_ATTACHMENT

# -------------------- Engine 2 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/engines/engine_2
	VEH_PART engine 1
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/engines/N2_percent[1] > 0
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Afterburner 2 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/engines/afterburner_2
	VEH_PART engine 1
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/engines/afterburner_ratio[1] > 0
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Starter ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/engines/starter
	VEH_PART engine 1
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/engines/starter_is_running[1] != 0
	EVENT_END_COND sim/flightmodel2/engines/starter_is_running[1] == 0
END_SOUND_ATTACHMENT

# -------------------- Engine fire ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/engines/engine_fire
	VEH_PART engine 1
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/operation/failures/rel_engfir1 == 6
	EVENT_END_COND sim/operation/failures/rel_engfir1 != 6
END_SOUND_ATTACHMENT

