# -------------------- Speedbrake ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /f4/switches/throttle_switch
	VEH_XYZ -0.378 0.602 -5.658
	EVENT_START_COND ABS_DELTA=laminar/F4/speedbrake_sw_pos > 0
END_SOUND_ATTACHMENT

